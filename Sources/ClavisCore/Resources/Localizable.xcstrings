        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписи требуют подтверждения присутствия через Touch ID (доступен 5-минутный льготный период для процесса Git). Ключи не кэшируются в общей памяти сессии."
          }
        }
      }
    }
  },
