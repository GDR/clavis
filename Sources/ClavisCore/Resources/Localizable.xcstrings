    },
    "create_key.hardware_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APPLE SILICON"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "APPLE SILICON"
          }
        }
