    "inspector.hardware_isolation_presence_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware Isolation (User Presence)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратная изоляция (присутствие пользователя)"
