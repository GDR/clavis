    "inspector.memory_protection_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked into non-pageable memory (mlock). Purged on screen lock or sleep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплено в невыгружаемой памяти (mlock). Очищается при блокировке экрана или сне."
          }
