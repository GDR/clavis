    "inspector.hardware_isolation_strict_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave strictly requires Touch ID matching the current biometric enrollment. Device password fallback is disabled. Changes to enrolled fingerprints will invalidate this key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave строго требует Touch ID, соответствующий текущим биометрическим данным. Ввод пароля отключен. Изменение отпечатков сделает ключ недействительным."
          }
        }
      }
    },
    "inspector.hardware_isolation_presence_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave keys cannot be cached in session memory. Every signature requires explicit Touch ID user presence (password fallback allowed)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи Secure Enclave не могут кэшироваться в памяти сессии. Каждая подпись требует подтверждения присутствия через Touch ID (разрешен ввод пароля)."
          }
        }
      }
    },
