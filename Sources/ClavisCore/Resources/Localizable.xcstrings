    },
    "create_key.hardware_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware-bound NIST P-256 key isolated inside the Apple Silicon chip. Private key never leaves hardware. Always prompts Touch ID per operation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратно привязанный ключ NIST P-256, изолированный внутри чипа Apple Silicon. Закрытый ключ никогда не покидает чип. Всегда запрашивает Touch ID на операцию."
          }
        }
      }
    },
