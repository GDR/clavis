    "inspector.posture_agent_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware Isolation (Agent Policy)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратная изоляция (политика агента)"
          }
        }
      }
    },
    "inspector.posture_agent_silent_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent sessions operate silently without prompts for up to %@ once authorized. Private key material remains hardware-bound in the Apple Secure Enclave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии агента работают тихо без запросов до %@ после авторизации. Закрытый ключ остается аппаратно изолированным в Apple Secure Enclave."
          }
        }
      }
    },
    "inspector.posture_agent_notify_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent sessions post a notification on each signature without prompting for up to %@. Private key material remains hardware-bound in the Apple Secure Enclave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии агента отправляют уведомление при каждой подписи без запроса до %@. Закрытый ключ остается аппаратно изолированным в Apple Secure Enclave."
          }
        }
      }
    },
    "inspector.posture_agent_ask_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent signature requires explicit Touch ID user confirmation. Private key material remains hardware-bound in the Apple Secure Enclave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая подпись агента требует явного подтверждения через Touch ID. Закрытый ключ остается аппаратно изолированным в Apple Secure Enclave."
          }
        }
      }
    },
    "inspector.posture_git_signing_only_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware Isolation (Git Signing Only)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратная изоляция (только подпись Git)"
          }
        }
      }
    },
    "inspector.posture_git_signing_only_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricted strictly to local Git commit and tag signing. Forwarded agent requests are blocked. Every signature requires Touch ID per operation (optional 5-minute process-scoped Git signing grace window)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничено исключительно локальной подписью коммитов и тегов Git. Запросы через forwarded agent блокируются. Каждая подпись требует Touch ID (доступен 5-минутный льготный период для процесса Git)."
          }
        }
      }
    },
    "inspector.posture_git_grace_active_suffix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " A 5-minute Git signing grace session is currently active for this key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Для этого ключа активен 5-минутный льготный период подписи Git."
