    },
    "inspector.posture_general_strict_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave strictly requires Touch ID matching current biometric enrollment. Every signature requires explicit Touch ID per operation (optional 5-minute process-scoped Git signing grace window). Device password fallback is disabled."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave строго требует Touch ID, соответствующий текущим биометрическим данным. Каждая подпись требует Touch ID (доступен 5-минутный льготный период для процесса Git). Ввод пароля отключен."
          }
        }
      }
    },
    "inspector.posture_general_presence_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signatures require Touch ID user presence per operation (optional 5-minute process-scoped Git signing grace window). Keys cannot be cached in general session memory."
          }
